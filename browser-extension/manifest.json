{
  "manifest_version": 3,
  "name": "TaskNest Capture",
  "version": "0.1.0",
  "description": "Send selected text and its page address to your local TaskNest app. Nothing leaves your computer.",
  "key": "",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Capture selection to TaskNest",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "nativeMessaging"
  ]
}
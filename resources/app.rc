#include <windows.h>

// Executable icon (also used for the taskbar button and Alt+Tab).
IDI_ICON1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "ProductName", "TaskNest"
            VALUE "FileDescription", "TaskNest offline todo"
            VALUE "OriginalFilename", "TaskNest.exe"
            VALUE "InternalName", "TaskNest"
            VALUE "FileVersion", "0.1.0"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
